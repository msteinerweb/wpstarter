{
    "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "color": {
            "custom": true,
            "customDuotone": true,
            "customGradient": true,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "link": true,
            "text": true,
            "background": true,
            "palette": [
                {
                    "name": "Primary",
                    "slug": "primary",
                    "color": "#244458"
                },
                {
                    "name": "Secondary",
                    "slug": "secondary",
                    "color": "#8A3232"
                },
                {
                    "name": "Tertiary",
                    "slug": "tertiary",
                    "color": "#F3AE3D"
                },
                {
                    "name": "Quaternary",
                    "slug": "quaternary",
                    "color": "#8EA67E"
                },
                {
                    "name": "Base",
                    "slug": "base",
                    "color": "#FFFFFF"
                },
                {
                    "name": "Contrast",
                    "slug": "contrast",
                    "color": "#1A1A1A"
                },
                {
                    "name": "Neutral",
                    "slug": "neutral",
                    "color": "#F5F5F5"
                }
            ],
            "gradients": [
                {
                    "name": "Primary to Secondary",
                    "slug": "primary-secondary",
                    "gradient": "linear-gradient(135deg, #244458 0%, #8A3232 100%)"
                },
                {
                    "name": "Tertiary to Quaternary",
                    "slug": "tertiary-quaternary",
                    "gradient": "linear-gradient(135deg, #F3AE3D 0%, #8EA67E 100%)"
                }
            ]
        },
        "layout": {
            "contentSize": "800px",
            "wideSize": "1200px"
        },
        "spacing": {
            "blockGap": true,
            "margin": true,
            "padding": true,
            "units": ["px", "em", "rem", "vh", "vw", "%"],
            "spacingScale": {
                "steps": 0
            },
            "spacingSizes": [
                {
                    "name": "X-Small",
                    "slug": "20",
                    "size": "0.5rem"
                },
                {
                    "name": "Small",
                    "slug": "30",
                    "size": "1rem"
                },
                {
                    "name": "Medium",
                    "slug": "40",
                    "size": "1.5rem"
                },
                {
                    "name": "Large",
                    "slug": "50",
                    "size": "2rem"
                },
                {
                    "name": "X-Large",
                    "slug": "60",
                    "size": "3rem"
                },
                {
                    "name": "2X-Large",
                    "slug": "70",
                    "size": "4rem"
                },
                {
                    "name": "3X-Large",
                    "slug": "80",
                    "size": "6rem"
                }
            ]
        },
        "typography": {
            "customFontSize": true,
            "fontStyle": true,
            "fontWeight": true,
            "letterSpacing": true,
            "lineHeight": true,
            "textDecoration": true,
            "textTransform": true,
            "dropCap": true,
            "fluid": true,
            "fontSizes": [
                {
                    "name": "Small",
                    "slug": "small",
                    "size": "0.875rem",
                    "fluid": {
                        "min": "0.8rem",
                        "max": "0.875rem"
                    }
                },
                {
                    "name": "Medium",
                    "slug": "medium",
                    "size": "1rem",
                    "fluid": {
                        "min": "0.9rem",
                        "max": "1rem"
                    }
                },
                {
                    "name": "Large",
                    "slug": "large",
                    "size": "1.25rem",
                    "fluid": {
                        "min": "1.1rem",
                        "max": "1.25rem"
                    }
                },
                {
                    "name": "X-Large",
                    "slug": "x-large",
                    "size": "1.75rem",
                    "fluid": {
                        "min": "1.5rem",
                        "max": "1.75rem"
                    }
                },
                {
                    "name": "2X-Large",
                    "slug": "xx-large",
                    "size": "2.25rem",
                    "fluid": {
                        "min": "1.875rem",
                        "max": "2.25rem"
                    }
                },
                {
                    "name": "3X-Large",
                    "slug": "xxx-large",
                    "size": "3rem",
                    "fluid": {
                        "min": "2.25rem",
                        "max": "3rem"
                    }
                }
            ],
            "fontFamilies": [
                {
                    "name": "System Font",
                    "slug": "system",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif"
                },
                {
                    "name": "Serif",
                    "slug": "serif",
                    "fontFamily": "Georgia, 'Times New Roman', Times, serif"
                },
                {
                    "name": "Monospace",
                    "slug": "monospace",
                    "fontFamily": "Consolas, Monaco, 'Courier New', monospace"
                }
            ]
        },
        "dimensions": {
            "aspectRatio": true,
            "minHeight": true
        },
        "position": {
            "sticky": true
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Small",
                    "slug": "small",
                    "shadow": "0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24)"
                },
                {
                    "name": "Medium",
                    "slug": "medium",
                    "shadow": "0 3px 6px rgba(0, 0, 0, 0.16), 0 3px 6px rgba(0, 0, 0, 0.23)"
                },
                {
                    "name": "Large",
                    "slug": "large",
                    "shadow": "0 10px 20px rgba(0, 0, 0, 0.19), 0 6px 6px rgba(0, 0, 0, 0.23)"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "spacing": {
            "blockGap": "1.5rem",
            "padding": {
                "top": "0",
                "right": "1.5rem",
                "bottom": "0",
                "left": "1.5rem"
            }
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--secondary)"
                    }
                }
            },
            "heading": {
                "typography": {
                    "fontWeight": "700",
                    "lineHeight": "1.2"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xxx-large)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-large)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "button": {
                "border": {
                    "radius": "0.25rem"
                },
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--base)"
                },
                "spacing": {
                    "padding": {
                        "top": "0.75rem",
                        "right": "1.5rem",
                        "bottom": "0.75rem",
                        "left": "1.5rem"
                    }
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--secondary)"
                    }
                }
            }
        },
        "blocks": {
            "core/button": {
                "variations": {
                    "outline": {
                        "border": {
                            "color": "currentColor",
                            "width": "2px",
                            "style": "solid"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--primary)"
                        }
                    }
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "blank",
            "title": "Blank",
            "postTypes": ["page", "post"]
        },
        {
            "name": "page-wide",
            "title": "Page (Wide)",
            "postTypes": ["page"]
        }
    ],
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ]
}
